# Static site served by nginx (for Dokploy: build type Dockerfile, port 80).
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html support.html privacy.html 404.html robots.txt sitemap.xml llms.txt /usr/share/nginx/html/
COPY assets /usr/share/nginx/html/assets
# Translated pages (generated by tool/i18n.py).
COPY de /usr/share/nginx/html/de
COPY ru /usr/share/nginx/html/ru
COPY fr /usr/share/nginx/html/fr
COPY kk /usr/share/nginx/html/kk
COPY cs /usr/share/nginx/html/cs
COPY es /usr/share/nginx/html/es
COPY zh /usr/share/nginx/html/zh
COPY ko /usr/share/nginx/html/ko
COPY it /usr/share/nginx/html/it
COPY mn /usr/share/nginx/html/mn
EXPOSE 80
